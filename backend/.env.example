# 复制为 backend/.env 后填写（.env 不入库）。完整配置项与默认值见 app/config.py。

# development | production。production 关闭 API 文档、收紧 CORS，并强制校验 SECRET_KEY 与 Turnstile
NCESNEXT_ENV=development
# DEBUG=false

# 签发 JWT / 邮件令牌 / OAuth state / 限流豁免凭证。生成：openssl rand -hex 32
# 必须取消注释并填入随机值；不要留空（空字符串会绕过默认开发密钥的启动检查）
# SECRET_KEY=

DATABASE_URL=mysql+mysqldb://ncesnext:ncesnext@localhost/icourse?charset=utf8mb4

# 站点地址（邮件链接、OAuth 回跳等）
FRONTEND_BASE_URL=http://localhost:8001
# 允许的前端 origin（JSON 数组）；不设置时按 NCESNEXT_ENV 派生默认值
# CORS_ORIGINS=["http://localhost:8001"]

# 外发邮件（注册激活、找回密码）
MAIL_SERVER=localhost
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_USE_TLS=false
MAIL_USE_SSL=false
# 开发时不真正发信
# MAIL_SUPPRESS_SEND=true

# Cloudflare Turnstile（变量名沿用 RECAPTCHA_ 是历史原因）。未配置时验证恒过，仅限开发环境
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# CRA SSO（OAuth2），不使用可留空
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# OAUTH_REDIRECT_URI=https://example.com/api/v1/auth/oauth/cra/callback
OAUTH_AUTH_URL=
OAUTH_TOKEN_URL=
OAUTH_API_URL=

# 用户上传（R2 / S3 兼容公开桶）。未配置凭证时上传接口返回 503
UGC_S3_ENDPOINT_URL=
UGC_S3_ACCESS_KEY=
UGC_S3_SECRET_KEY=
# UGC_S3_BUCKET_NAME=
# UGC_S3_PUBLIC_BASE_URL=https://ugc.example.com

# 课程资料桶（与 UGC 桶独立）
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=

# 老系统存量上传文件目录（只读）
# UPLOAD_FOLDER=/var/lib/ncesnext/uploads

# 限流（进程内计数，全局约为配置值 × worker 数）。本地开发可关闭
# RATE_LIMIT_ENABLED=false

# 内容写入审计日志（JSONL）
# WRITE_AUDIT_ENABLED=true
# WRITE_AUDIT_PATH=/var/log/ncesnext/write_audit.jsonl

# 搜索：sql（默认）或 meilisearch，见 meilisearch/README.md
SEARCH_ENGINE=sql
# MEILISEARCH_URL=http://127.0.0.1:7701
# MEILISEARCH_KEY=

# AI 课程总结（仅离线脚本使用），见 summaries/README.md
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=
# LLM_MODEL=deepseek-v4-pro
